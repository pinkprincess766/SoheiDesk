{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoheiDesk",
  "version": "1.1.0",
  "identifier": "com.soheidesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "SoheiDesk",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**",
            "$APPLOCALDATA/**",
            "$APPCACHE/**",
            "$RESOURCE/**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Scientific reader and lab journal",
    "longDescription": "SoheiDesk is a desktop workspace for researchers: read papers, annotate, keep a lab journal, export reports, and manage bibliography — offline-first.",
    "copyright": "SoheiDesk",
    "publisher": "SoheiDesk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    },
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "description": "Open PDF in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["md", "markdown"],
        "name": "Markdown",
        "description": "Open Markdown in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["docx"],
        "name": "Word Document",
        "description": "Open DOCX in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["txt", "text"],
        "name": "Plain Text",
        "description": "Open text in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["tex", "latex"],
        "name": "LaTeX",
        "description": "Open TeX in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["epub"],
        "name": "EPUB",
        "description": "Open EPUB in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["html", "htm"],
        "name": "HTML",
        "description": "Open HTML in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["fb2"],
        "name": "FictionBook",
        "description": "Open FB2 in SoheiDesk",
        "role": "Viewer"
      },
      {
        "ext": ["djvu", "djv"],
        "name": "DjVu",
        "description": "Open DjVu in SoheiDesk",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {}
}
