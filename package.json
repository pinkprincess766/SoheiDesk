{
  "name": "soheidesk",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test:frontend": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:dev:ui": "vite --port 1420 --strictPort",
    "app:build": "tauri build",
    "app:build:arm": "tauri build --target aarch64-apple-darwin",
    "app:icons": "tauri icon assets/brand/app-icon-1024.png",
    "clean": "bash scripts/clean.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "pdfjs-dist": "^6.1.200",
    "pinia": "^4.0.2",
    "vue": "^3.5.13",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~5.6.2",
    "vite": "^7.3.0",
    "vue-tsc": "^2.1.10"
  },
  "description": "SoheiDesk — scientific reader and lab journal",
  "pnpm": {
    "overrides": {
      "brace-expansion@>=2.0.0 <2.1.3": "2.1.3"
    }
  }
}
